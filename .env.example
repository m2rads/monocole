# Copy to .env to switch these on. The app works without this file.

# Keep a copy of every utterance sent to whisper, as a WAV.
#
# For when a transcript comes back wrong and you need to tell bad audio from
# bad transcription — the only way to know is to listen to what whisper was
# actually given. Off by default because it writes a few hundred KB per
# sentence and never cleans up after itself.
#
# Files land in:
#   ~/Library/Application Support/com.atelier.minicole/utterances/
TROUBLESHOOT_VOICE_RECORDING=false

# Override some defaults so BT stack is enabled
# in this example

# BT config
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y

# Custom partition table: esp-sr needs a partition labelled "model" for the
# WakeNet models, which no built-in table provides. See partitions.csv for the
# layout and why nvs stays exactly where the old table put it.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Persist bonding keys in NVS. Without this the chip forgets the bond on every
# boot while the host still has it, and every write to a WRITE_ENC
# characteristic (wifi_creds, wifi_control) fails. See ble_hs_cfg in main.c.
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# The MTU we offer during exchange; the negotiated value is the lower of the
# two ends. NimBLE defaults to 256, which is why the link settled there — macOS
# offers considerably more. Voice needs the payload: ADPCM at 64 kbps is 8 KB/s,
# and a bigger MTU is fewer notifications for the same audio.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512

# PSRAM. esptool reports this module as "Embedded PSRAM 8MB (AP_3v3)", and 8 MB
# embedded on an ESP32-S3 is the octal-interface part — the quad default would
# fail to initialise it. The camera will need this; enabling it now means one
# memory-layout change instead of two.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Speech recognition. One wake word — "Hi ESP" — and nothing else: every model
# selected here is packed into the model partition, and the point of starting
# with one is that the partition stays small and the false-trigger surface
# stays understandable.
#
# The AFE's noise suppression and VAD both default to the WebRTC
# implementations, which are algorithmic and ship no model files. Switching
# either to its neural version (nsnet2, vadnet1) adds to the model partition.
#
# Swapping the wake word is one line here: the component carries about twenty
# English phrases — Hi ESP (SR_WN_WN9_HIESP), Alexa (SR_WN_WN9_ALEXA),
# Computer, Mycroft and so on. Nothing outside this file, and nothing on the
# wire, knows which one is loaded.
#
# Two are loaded, and either one wakes the device. WakeNet supports up to five,
# told apart by wakenet_model_index.
#
# Jarvis is the one to say: distinctive, and unlike Alexa no Echo in the room
# answers it. But it is a `_tts` model — trained on synthesized speech rather
# than real recordings — and it is correspondingly less certain about actual
# voices, which shows up as having to repeat yourself.
#
# Hi ESP is kept alongside it as the one that always works. Only Hi ESP and
# Alexa are trained on real data in the English set, and Hi ESP was reliable
# first try on hardware. Two models cost ~584 KB, which is why partitions.csv
# gives `model` 1 M.
CONFIG_SR_WN_WN9_JARVIS_TTS=y
CONFIG_SR_WN_WN9_HIESP=y

# WiFi config
CONFIG_ESP_WIFI_IRAM_OPT=n

# The XIAO ESP32-S3 has 8 MB; builds otherwise default to 2 MB and the
# bootloader warns. This belongs here rather than in menuconfig because
# `idf.py set-target` resets sdkconfig but not sdkconfig.defaults.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
